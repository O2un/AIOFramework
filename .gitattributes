# Unity가 LF로 다시 쓰는 파일들. core.autocrlf=true 가 체크아웃 때 CRLF로 바꿔 놓으면
# 내용이 그대로여도 계속 수정된 것으로 뜬다.
ProjectSettings/*.asset text eol=lf

# Assets/ 아래 YAML 에셋도 같은 이유로 고정한다. String Table 처럼 Unity가
# 통째로 다시 쓰는 에셋에서 같은 증상이 난다.
*.asset text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.playable text eol=lf
*.signal text eol=lf
*.mixer text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.spriteatlas text eol=lf
*.terrainlayer text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.inputactions text eol=lf
