.demo-root {
    width: 50%;
    height: 100%;
    padding: 88px 24px 24px 24px;
    background-color: rgb(18, 18, 18);
}

.stack-tag {
    align-self: flex-start;
    margin-bottom: 16px;
    padding: 2px 8px;
    border-radius: 2px;
    background-color: rgb(30, 215, 96);
    color: rgb(0, 0, 0);
    font-size: 11px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
}

.demo-header {
    margin-bottom: 20px;
}

.title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.subtitle {
    margin-top: 4px;
    font-size: 12px;
    color: rgb(179, 179, 179);
    white-space: normal;
}

.demo-card {
    padding: 12px;
    margin-bottom: 16px;
    border-radius: 8px;
    background-color: rgb(24, 24, 24);
}

.line {
    margin-bottom: 8px;
    font-size: 16px;
    color: rgb(255, 255, 255);
    white-space: normal;
}

.accent-line {
    margin-bottom: 0;
    color: rgb(30, 215, 96);
    -unity-font-style: bold;
}

.status-row {
    flex-direction: row;
    margin-bottom: 20px;
}

.status-chip {
    margin-right: 8px;
    padding: 2px 8px;
    border-radius: 2px;
    border-width: 1px;
    border-color: rgb(77, 77, 77);
    background-color: rgb(31, 31, 31);
    color: rgb(179, 179, 179);
    font-size: 11px;
}

.demo-footer {
    flex-direction: row;
    align-items: center;
}

.pill-button {
    height: 34px;
    padding: 0 16px;
    margin: 0;
    border-radius: 17px;
    border-width: 0;
    background-color: rgb(31, 31, 31);
    color: rgb(255, 255, 255);
    font-size: 14px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.pill-button:hover {
    background-color: rgb(47, 47, 47);
}

.pill-button:active {
    background-color: rgb(58, 58, 58);
}

.pill-button.accent {
    background-color: rgb(30, 215, 96);
    color: rgb(0, 0, 0);
}

.pill-button.accent:hover {
    background-color: rgb(29, 185, 84);
}
