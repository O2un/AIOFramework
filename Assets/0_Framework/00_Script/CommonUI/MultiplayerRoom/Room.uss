.room {
    flex-grow: 1;
    background-color: rgb(18, 18, 18);
    padding: 24px;
}

.room-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.room-title-area {
    flex-direction: row;
    align-items: center;
}

.room-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.room-code {
    margin-left: 12px;
    font-size: 24px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
    color: rgb(30, 215, 96);
}

.room-role {
    height: 18px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 2px;
    background-color: rgb(31, 31, 31);
    color: rgb(179, 179, 179);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.room-body {
    flex-grow: 1;
    background-color: rgb(24, 24, 24);
    border-radius: 8px;
    padding: 16px;
}

.room-panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.room-panel-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.room-player-count {
    font-size: 12px;
    color: rgb(179, 179, 179);
}

.room-player-list {
    flex-grow: 1;
}

.room-player-row {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 8px;
    border-radius: 6px;
    background-color: rgb(31, 31, 31);
}

.room-player-row.local {
    border-width: 1px;
    border-color: rgb(77, 77, 77);
}

.room-player-name {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 16px;
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
}

.room-player-badge {
    height: 18px;
    padding-left: 8px;
    padding-right: 8px;
    margin-left: 12px;
    border-radius: 2px;
    background-color: rgb(37, 37, 37);
    color: rgb(179, 179, 179);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.room-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 20px;
}

.room-button {
    height: 34px;
    padding-left: 16px;
    padding-right: 16px;
    margin: 0 0 0 12px;
    border-radius: 17px;
    border-width: 0;
    background-color: rgb(31, 31, 31);
    color: rgb(255, 255, 255);
    font-size: 14px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.room-button:hover {
    background-color: rgb(47, 47, 47);
}

.room-button:active {
    background-color: rgb(58, 58, 58);
}

.room-button:disabled {
    opacity: 0.4;
}

.room-button.accent {
    background-color: rgb(30, 215, 96);
    color: rgb(0, 0, 0);
}

.room-button.accent:hover {
    background-color: rgb(29, 185, 84);
}

.room-button.outlined {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(124, 124, 124);
}

.room-button.outlined:hover {
    background-color: rgb(31, 31, 31);
}
